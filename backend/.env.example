# ── Only ONE key needed — get it free at aistudio.google.com ──
GEMINI_API_KEY= gsk_your-groq-key-here

# ── Everything else runs locally — no accounts needed ──────────
DATABASE_URL=sqlite+aiosqlite:///./studyai.db
UPLOAD_DIR=./uploads
CHROMA_DIR=./chromadb
ALLOWED_ORIGINS=http://localhost:3000

# ── Settings ───────────────────────────────────────────────────
MAX_FILE_SIZE_MB=50
CHUNK_SIZE=500
CHUNK_OVERLAP=100
TOP_K_RESULTS=5
